# Facebook Pages API
# استخدم توكن صفحة رسميًا فقط. لا تضع كوكيز المتصفح أو توكن حساب شخصي هنا.
FB_PAGE_ACCESS_TOKEN=your_page_access_token
FB_PAGE_ID=your_page_id
FB_APP_SECRET=your_app_secret
FB_VERIFY_TOKEN=replace_with_a_long_random_verify_token
FB_GRAPH_API_VERSION=v26.0

# Admin Settings
# استخدم قيمة قوية وفريدة في بيئة الإنتاج.
ADMIN_PASSWORD=replace_with_a_long_random_password
ADMIN_ACTIVATION_KEY=replace_with_a_long_random_activation_key

# Database
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/okami_db

# App Settings
PORT=8080
NODE_ENV=production
DATA_DIR=./data
SCRAPER_TIMEOUT_MS=15000
SCRAPER_CACHE_TTL_SECONDS=3600
